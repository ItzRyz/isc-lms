# Supabase - public (exposed to browser) - gunakan ANON_KEY atau PUBLISHABLE_KEY (alias)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key # alternatif baru Supabase

# Supabase - server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email - Resend (server only)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# FastAPI ML Service (server only)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_SECRET=your-internal-secret

# Observability (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
