# Supabase - public (exposed to browser) - gunakan ANON_KEY atau PUBLISHABLE_KEY (alias)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key # alternatif baru Supabase

# Supabase - server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email - Resend (server only) — per-event FROM (jawaban #1: per event, #3 via Supabase SMTP)
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Per-event FROM (opsional, fallback ke RESEND_FROM_EMAIL jika kosong) — semua harus verified di Resend Domains
# RESEND_FROM_AUTH=auth@yourdomain.com
# RESEND_FROM_ASSIGNMENTS=assignments@yourdomain.com
# RESEND_FROM_QUIZZES=quizzes@yourdomain.com
# RESEND_FROM_GRADES=grades@yourdomain.com
# RESEND_FROM_CERTIFICATES=certificates@yourdomain.com
# RESEND_FROM_EVENTS=events@yourdomain.com
# RESEND_FROM_ANNOUNCEMENTS=announcements@yourdomain.com
# Supabase Auth SMTP (jawaban #3) — set di Supabase Dashboard → Auth → SMTP:
# Host: smtp.resend.com | Port: 465 | User: resend | Pass: RESEND_API_KEY | Sender: RESEND_FROM_AUTH

# FastAPI ML Service (server only)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_SECRET=your-internal-secret

# Observability (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
