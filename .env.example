# Supabase - public (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email - Sender (server only)
SENDER_API_KEY=your-sender-api-key
SENDER_FROM_EMAIL=noreply@yourdomain.com

# FastAPI ML Service (server only)
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_SECRET=your-internal-secret

# Observability (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
